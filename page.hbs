{{!< default}}

{{#post}}
<main id="site-main" class="bl-main">
    <article class="bl-article-shell {{post_class}}">
        <div class="bl-container">
            {{#match @page.show_title_and_feature_image}}
                <header class="bl-article-header">
                    <h1 class="bl-article-title">{{title}}</h1>
                    {{#if custom_excerpt}}
                        <p class="bl-article-dek">{{custom_excerpt}}</p>
                    {{/if}}
                </header>

                {{#if feature_image}}
                <figure class="bl-article-hero-media">
                    <img src="{{img_url feature_image size="xl"}}"
                         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
                {{/if}}
            {{/match}}

            <div style="max-width:780px;margin:0 auto;">
                <section class="bl-prose gh-content">
                    {{content}}
                </section>
            </div>
        </div>
    </article>
</main>
{{/post}}
