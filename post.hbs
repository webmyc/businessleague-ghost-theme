{{!< default}}

{{#post}}
<main id="site-main" class="bl-main">
    <article class="bl-article-shell {{post_class}}"
             data-post-id="{{id}}"
             data-post-slug="{{slug}}"
             data-post-tags="{{#foreach tags visibility="all"}}{{slug}},{{/foreach}}">

        {{!-- Full AEO / GEO / LLM Structured Data: BlogPosting + BreadcrumbList + Speakable --}}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "BusinessLeague Blog",
                            "item": "{{@site.url}}"
                        },
                        {{#primary_tag}}
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "{{name}}",
                            "item": "{{url absolute="true"}}"
                        },
                        {{/primary_tag}}
                        {
                            "@type": "ListItem",
                            "position": 3,
                            "name": "{{encode title}}",
                            "item": "{{url absolute="true"}}"
                        }
                    ]
                },
                {
                    "@type": "BlogPosting",
                    "headline": "{{encode title}}",
                    "description": "{{#if custom_excerpt}}{{encode custom_excerpt}}{{else}}{{encode excerpt}}{{/if}}",
                    "url": "{{url absolute="true"}}",
                    "datePublished": "{{date format="YYYY-MM-DDTHH:mm:ssZ"}}",
                    "dateModified": "{{date updated_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
                    {{#if feature_image}}
                    "image": [
                        "{{img_url feature_image size="xl" absolute="true"}}"
                    ],
                    {{/if}}
                    {{#if authors}}
                    "author": [
                        {{#foreach authors}}
                        {
                            "@type": "Person",
                            "name": "{{name}}",
                            "url": "{{url absolute="true"}}"
                        }{{#unless @last}},{{/unless}}
                        {{/foreach}}
                    ],
                    {{/if}}
                    "publisher": {
                        "@type": "Organization",
                        "name": "BusinessLeague by 2Performant",
                        "logo": {
                            "@type": "ImageObject",
                            "url": "https://start.businessleague.com/img/logo-horizontal-dark.png"
                        }
                    },
                    "speakable": {
                        "@type": "SpeakableSpecification",
                        "cssSelector": [".bl-article-title", ".bl-article-dek", ".bl-prose h2"]
                    }
                }
            ]
        }
        </script>

        <div class="bl-container">
            <header class="bl-article-header">
                {{!-- Breadcrumbs --}}
                <nav class="bl-breadcrumbs" aria-label="Breadcrumb">
                    <a href="{{@site.url}}" data-i18n="breadcrumb_home">Acasă</a>
                    <span>/</span>
                    {{#primary_tag}}
                        <a href="{{url}}">{{name}}</a>
                        <span>/</span>
                    {{/primary_tag}}
                    <a href="{{@site.url}}/#pillar-all" class="bl-pillar-badge" data-pillar-badge data-pillar-link="all">Editorial</a>
                </nav>

                {{!-- IN-ARTICLE LANGUAGE SWITCHER BAR (Key User Requirement) --}}
                <div class="bl-article-lang-bar" id="bl-article-lang-bar" role="region" aria-label="Article Language Translations">
                    <div class="bl-article-lang-label">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        <span data-i18n="article_lang_prompt">Citește acest articol în:</span>
                    </div>
                    <div class="bl-article-lang-pills" data-article-lang-pills>
                        <a href="?lang=ro" class="bl-article-lang-pill" data-article-lang="ro">
                            <span>🇷🇴</span>
                            <span>Română</span>
                        </a>
                        <a href="?lang=en" class="bl-article-lang-pill" data-article-lang="en">
                            <span>🇬🇧</span>
                            <span>English</span>
                        </a>
                        <a href="?lang=bg" class="bl-article-lang-pill" data-article-lang="bg">
                            <span>🇧🇬</span>
                            <span>Български</span>
                        </a>
                        <a href="?lang=es" class="bl-article-lang-pill" data-article-lang="es">
                            <span>🇪🇸</span>
                            <span>Español</span>
                        </a>
                    </div>
                </div>

                {{!-- Article Headline & Dek --}}
                <h1 class="bl-article-title">{{title}}</h1>

                {{#if custom_excerpt}}
                    <p class="bl-article-dek">{{custom_excerpt}}</p>
                {{/if}}

                {{!-- Author Byline & Share Actions --}}
                <div class="bl-article-byline-bar">
                    <div class="bl-byline-author">
                        {{#if authors}}
                            <div class="bl-byline-avatars">
                                {{#foreach authors}}
                                    {{#if profile_image}}
                                        <a class="bl-byline-avatar-link" href="{{url}}" title="{{name}}" aria-label="{{name}}">
                                            <img class="bl-byline-avatar" src="{{img_url profile_image size="s" format="webp"}}" alt="{{name}}" width="44" height="44" decoding="async" />
                                        </a>
                                    {{/if}}
                                {{/foreach}}
                            </div>
                        {{/if}}
                        <div class="bl-byline-info">
                            <div class="bl-byline-names">
                                {{#foreach authors}}<a class="bl-byline-name" href="{{url}}">{{name}}</a>{{#unless @last}}<span class="bl-byline-sep">, </span>{{/unless}}{{/foreach}}
                            </div>
                            <div class="bl-byline-meta">
                                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                                {{#if reading_time}} &bull; {{reading_time}}{{/if}}
                                {{#if comments}} &bull; <a href="#bl-comments" class="bl-byline-comments-link">{{comment_count empty="Comentează" singular="comentariu" plural="comentarii"}}</a>{{/if}}
                            </div>
                        </div>
                    </div>

                    <div class="bl-share-group">
                        <span class="bl-share-label" data-i18n="share_label">Distribuie</span>
                        <a class="bl-share-btn"
                           href="https://www.linkedin.com/shareArticle?mini=true&url={{url absolute="true"}}&title={{encode title}}"
                           target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="LinkedIn">
                            <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                        </a>
                        <a class="bl-share-btn"
                           href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}"
                           target="_blank" rel="noopener" aria-label="Share on X" title="X / Twitter">
                            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a class="bl-share-btn"
                           href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}"
                           target="_blank" rel="noopener" aria-label="Share on Facebook" title="Facebook">
                            <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
                        </a>
                        <button type="button" class="bl-share-btn" data-copy-link="{{url absolute="true"}}" aria-label="Copy Link" title="Copy Link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill:none;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        </button>
                    </div>
                </div>

                {{!-- IMPECCABLE TYPOGRAPHY & READING CONTROLS TOOLBAR --}}
                <div class="bl-reading-toolbar" role="toolbar" aria-label="Reading Typography and Layout Controls">
                    <div class="bl-reading-toolbar-left">
                        <span class="bl-reading-toolbar-kicker">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
                            <span data-i18n="reading_prefs_label">Mod Lectură &amp; Tipografie</span>
                        </span>
                    </div>

                    <div class="bl-reading-toolbar-controls">
                        {{!-- Font Size Controls: A- / A / A+ --}}
                        <div class="bl-reading-control-group" role="group" aria-label="Font Size">
                            <button type="button" class="bl-reading-btn" data-reading-size-action="decrease" title="Decrease font size (A-)">
                                <span>A−</span>
                            </button>
                            <button type="button" class="bl-reading-btn" data-reading-size-action="reset" data-reading-size-indicator title="Reset font size">
                                <span>100%</span>
                            </button>
                            <button type="button" class="bl-reading-btn" data-reading-size-action="increase" title="Increase font size (A+)">
                                <span>A+</span>
                            </button>
                        </div>

                        {{!-- Typeface Toggle: Sans (Inter) vs Editorial Serif (Newsreader) --}}
                        <div class="bl-reading-control-group" role="group" aria-label="Typeface">
                            <button type="button" class="bl-reading-btn" data-set-reading-font="sans">
                                <span data-i18n="reading_font_sans">Sans</span>
                            </button>
                            <button type="button" class="bl-reading-btn" data-set-reading-font="serif">
                                <span class="bl-serif-sample">Aa</span>
                                <span data-i18n="reading_font_serif">Editorial Serif</span>
                            </button>
                        </div>

                        {{!-- Reading Layout Mode: Standard (2-col with Rail) vs Zen Focus (Centered 68ch) --}}
                        <div class="bl-reading-control-group" role="group" aria-label="Reading Layout">
                            <button type="button" class="bl-reading-btn" data-set-reading-layout="standard">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
                                <span data-i18n="reading_layout_standard">Standard</span>
                            </button>
                            <button type="button" class="bl-reading-btn" data-set-reading-layout="zen">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>
                                <span data-i18n="reading_layout_zen">Zen Focus</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            {{!-- Uncropped Feature Image (100% intrinsic aspect ratio preserved) or Category Cover Fallback --}}
            <figure class="bl-article-hero-media">
                {{#if feature_image}}
                <img src="{{img_url feature_image size="l" format="webp"}}"
                     srcset="{{img_url feature_image size="s" format="webp"}} 300w,
                             {{img_url feature_image size="m" format="webp"}} 600w,
                             {{img_url feature_image size="l" format="webp"}} 1000w,
                             {{img_url feature_image size="xl" format="webp"}} 2000w"
                     sizes="(max-width: 680px) 360px, (max-width: 1000px) 92vw, 960px"
                     width="1000"
                     height="563"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     fetchpriority="high" />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
                {{else}}
                    {{> "category-cover"}}
                {{/if}}
            </figure>

            {{!-- 2-Column Editorial Prose + Sticky Right Sidebar --}}
            <div class="bl-article-grid">
                <div class="bl-article-main">
                    <section class="bl-prose gh-content" id="bl-article-prose">
                        {{content}}
                    </section>

                    {{!-- Bottom Share & Language Bar --}}
                    <div class="bl-article-byline-bar" style="margin-top:48px;">
                        <div class="bl-article-lang-label">
                            <span data-i18n="article_lang_prompt">Citește acest articol în:</span>
                            <div class="bl-article-lang-pills" data-article-lang-pills>
                                <a href="?lang=ro" class="bl-article-lang-pill" data-article-lang="ro">🇷🇴 RO</a>
                                <a href="?lang=en" class="bl-article-lang-pill" data-article-lang="en">🇬🇧 EN</a>
                                <a href="?lang=bg" class="bl-article-lang-pill" data-article-lang="bg">🇧🇬 BG</a>
                                <a href="?lang=es" class="bl-article-lang-pill" data-article-lang="es">🇪🇸 ES</a>
                            </div>
                        </div>

                        <div class="bl-share-group">
                            <span class="bl-share-label" data-i18n="share_label">Distribuie</span>
                            <a class="bl-share-btn" href="https://www.linkedin.com/shareArticle?mini=true&url={{url absolute="true"}}&title={{encode title}}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
                                <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                            </a>
                            <a class="bl-share-btn" href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener" aria-label="Share on X">
                                <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a class="bl-share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" target="_blank" rel="noopener" aria-label="Share on Facebook">
                                <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
                            </a>
                        </div>
                    </div>

                    {{!-- Native Ghost Member Comments Section --}}
                    {{#if comments}}
                        <section class="bl-comments-section" id="bl-comments">
                            <div class="bl-comments-header">
                                <div class="bl-comments-title-wrap">
                                    <span class="bl-section-eyebrow" data-i18n="comments_eyebrow">DISCUȚIE ÎN ARENĂ // COMUNITATE</span>
                                    <h3 class="bl-comments-title" data-i18n="comments_title">Comentarii &amp; Dezbateri pe Cifre</h3>
                                </div>
                                <span class="bl-comments-count-badge">
                                    {{comment_count empty="0 comentarii" singular="comentariu" plural="comentarii"}}
                                </span>
                            </div>
                            <div class="bl-comments-embed">
                                {{comments title="" count=false mode="auto"}}
                            </div>
                        </section>
                    {{/if}}
                </div>

                {{!-- Sticky Right Rail: TOC + Language Switcher + Ecosystem Card --}}
                <aside class="bl-article-rail" aria-label="Article Sidebar">
                    <div class="bl-rail-card" id="bl-toc-card" style="display:none;">
                        <h4 class="bl-rail-title">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                            <span data-i18n="toc_title">Cuprins Articol</span>
                        </h4>
                        <ul class="bl-toc-list" id="bl-toc-list"></ul>
                    </div>

                    <div class="bl-rail-card">
                        <h4 class="bl-rail-title">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            <span data-i18n="rail_lang_title">Versiuni Disponibile</span>
                        </h4>
                        <div class="bl-article-lang-pills" data-article-lang-pills style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                            <a href="?lang=ro" class="bl-article-lang-pill" data-article-lang="ro">🇷🇴 Română</a>
                            <a href="?lang=en" class="bl-article-lang-pill" data-article-lang="en">🇬🇧 English</a>
                            <a href="?lang=bg" class="bl-article-lang-pill" data-article-lang="bg">🇧🇬 Български</a>
                            <a href="?lang=es" class="bl-article-lang-pill" data-article-lang="es">🇪🇸 Español</a>
                        </div>
                    </div>

                    {{!-- Live Luma Next Community Events Card --}}
                    {{> "community-events-card"}}

                    <div class="bl-ecosystem-card">
                        <span class="bl-section-eyebrow">BUSINESSLEAGUE</span>
                        <h4 class="bl-ecosystem-title" data-i18n="eco_title">Crește-ți vânzările sau câștigă comisioane prin performanță pură</h4>
                        <p class="bl-ecosystem-desc" data-i18n="eco_desc">
                            Intră în campionatul de marketing descentralizat #1 din CEE.
                        </p>
                        <a class="bl-cta-btn" href="https://businessleague.com" target="_blank" rel="noopener" style="width:100%;justify-content:center;box-sizing:border-box;">
                            <span data-i18n="cta_join">Intră în Ligă</span>
                            <span>↗</span>
                        </a>
                    </div>
                </aside>
            </div>

            {{!-- Related Articles in Same Language — All 4 on ONE Single Row on Desktop --}}
            <section class="bl-section" style="margin-top:72px;">
                <div class="bl-section-header">
                    <div>
                        <span class="bl-section-eyebrow" data-i18n="related_eyebrow">CONTINUĂ LECTURA</span>
                        <h2 class="bl-section-title" data-i18n="related_title">Articole Recomandate</h2>
                    </div>
                </div>
                <div class="bl-related-grid">
                    {{#has tag="en"}}
                        {{#get "posts" filter="id:-{{id}}+tag:en" include="tags,authors" limit="4" as |more_posts|}}
                            {{#foreach more_posts}}{{> "post-card"}}{{/foreach}}
                        {{/get}}
                    {{else has tag="bg"}}
                        {{#get "posts" filter="id:-{{id}}+tag:bg" include="tags,authors" limit="4" as |more_posts|}}
                            {{#foreach more_posts}}{{> "post-card"}}{{/foreach}}
                        {{/get}}
                    {{else has tag="es"}}
                        {{#get "posts" filter="id:-{{id}}+tag:es" include="tags,authors" limit="4" as |more_posts|}}
                            {{#foreach more_posts}}{{> "post-card"}}{{/foreach}}
                        {{/get}}
                    {{else}}
                        {{#get "posts" filter="id:-{{id}}+tag:-en+tag:-bg+tag:-es" include="tags,authors" limit="4" as |more_posts|}}
                            {{#foreach more_posts}}{{> "post-card"}}{{/foreach}}
                        {{/get}}
                    {{/has}}
                </div>
            </section>
        </div>
    </article>
</main>
{{/post}}
