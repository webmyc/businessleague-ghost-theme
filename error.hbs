{{!< default}}

<main id="site-main" class="bl-main">
    <div class="bl-container" style="padding:96px 24px;text-align:center;">
        <span class="bl-section-eyebrow">ERROR {{statusCode}}</span>
        <h1 class="bl-article-title" style="margin-bottom:16px !important;">{{message}}</h1>
        <p style="color:var(--bl-text-secondary);margin-bottom:28px;">Pagina solicitată nu a fost găsită sau a fost mutată.</p>
        <a class="bl-cta-btn" href="{{@site.url}}">Înapoi la prima pagină &rarr;</a>
    </div>
</main>
