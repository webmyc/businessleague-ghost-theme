{{!< default}}

<main id="site-main" class="bl-main">
    <div class="bl-container">
        {{#tag}}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            "name": "{{encode name}} — BusinessLeague Blog",
            "description": "{{#if description}}{{encode description}}{{else}}Articole, analize și studii de caz din colecția {{encode name}} pe BusinessLeague Blog.{{/if}}",
            "url": "{{url absolute="true"}}",
            "isPartOf": {
                "@type": "WebSite",
                "name": "BusinessLeague Blog",
                "url": "{{@site.url}}"
            }
        }
        </script>
        <section class="bl-masthead">
            <div class="bl-masthead-top">
                <div>
                    <div class="bl-masthead-eyebrow">
                        <span class="bl-pulse-dot" aria-hidden="true"></span>
                        <span>COLLECTION &bull; {{slug}}</span>
                    </div>
                    <h1 class="bl-masthead-title">{{name}}</h1>
                    <p class="bl-masthead-subtitle">
                        {{#if description}}
                            {{description}}
                        {{else}}
                            {{plural ../pagination.total empty='0 articles' singular='% article' plural='% articles'}}
                        {{/if}}
                    </p>
                </div>
            </div>
        </section>
        {{/tag}}

        <section class="bl-section">
            <div class="bl-grid-3">
                {{#tag}}
                    {{#has slug="ro"}}
                        {{#get "posts" filter="tag:-[en,hash-en,bg,hash-bg,es,hash-es]" include="tags,authors" limit="24" as |ro_hub_posts|}}
                            {{#foreach ro_hub_posts}}
                                {{> "post-card"}}
                            {{/foreach}}
                        {{/get}}
                    {{else}}
                        {{#foreach ../posts}}
                            {{> "post-card"}}
                        {{/foreach}}
                    {{/has}}
                {{/tag}}
            </div>
            <div class="bl-load-more-wrap">
                {{pagination}}
            </div>
        </section>

        {{#tag}}
            {{#has slug="ro,en,bg,es,business-league,pentru-afiliati,pentru-furnizori,stiri-din-piata,interviuri-2,how-to,seo,ppc,afiliere-fashion,black-friday-2"}}
            <nav class="bl-seo-hub-directory" aria-label="{{name}} Complete Archive">
                <div class="bl-seo-hub-col">
                    <h3>Arhiva Indexată — {{name}} (Top 100 Articole)</h3>
                    <ul class="bl-seo-hub-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:8px 24px;">
                        {{#has slug="ro"}}
                            {{#get "posts" filter="tag:-[en,hash-en,bg,hash-bg,es,hash-es]" limit="100" fields="title,url" as |archive_posts|}}
                                {{#foreach archive_posts}}
                                    <li><a href="{{url}}">{{title}}</a></li>
                                {{/foreach}}
                            {{/get}}
                        {{else}}
                            {{#get "posts" filter="tag:{{slug}}" limit="100" fields="title,url" as |archive_posts|}}
                                {{#foreach archive_posts}}
                                    <li><a href="{{url}}">{{title}}</a></li>
                                {{/foreach}}
                            {{/get}}
                        {{/has}}
                    </ul>
                </div>
            </nav>
            {{/has}}
        {{/tag}}
    </div>
</main>
