<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="dark" data-bl-lang="ro" class="dark-mode">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{{meta_title}}</title>

    {{!-- Synchronous Zero-Flicker Language & Theme Detection Engine --}}
    <script>
    (function() {
        var SUPPORTED = ['ro', 'en', 'bg', 'es'];
        var html = document.documentElement;

        // 1. Theme resolution (Default: BusinessLeague Signature Dark Mode)
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('bl_theme'); } catch (e) {}
        var theme = (savedTheme === 'light' || savedTheme === 'dark') ? savedTheme : 'dark';
        html.setAttribute('data-theme', theme);
        if (theme === 'dark') {
            html.classList.add('dark-mode');
        } else {
            html.classList.remove('dark-mode');
        }

        // 2. Language resolution: ?lang= param -> /tag/{lang}/ -> saved preference -> browser navigator.language
        var urlParams = new URLSearchParams(window.location.search);
        var queryLang = (urlParams.get('lang') || '').toLowerCase();
        var pathMatch = window.location.pathname.match(/^\/tag\/(ro|en|bg|es)(\/|$)/i);
        var pathLang = pathMatch ? pathMatch[1].toLowerCase() : '';
        var savedLang = '';
        try { savedLang = (localStorage.getItem('bl_lang') || '').toLowerCase(); } catch (e) {}

        var browserLang = '';
        var navLangs = navigator.languages || [navigator.language || 'ro'];
        for (var i = 0; i < navLangs.length; i++) {
            var code = String(navLangs[i] || '').slice(0, 2).toLowerCase();
            if (SUPPORTED.indexOf(code) !== -1) {
                browserLang = code;
                break;
            }
        }

        var activeLang = 'ro';
        if (SUPPORTED.indexOf(queryLang) !== -1) {
            activeLang = queryLang;
        } else if (SUPPORTED.indexOf(pathLang) !== -1) {
            activeLang = pathLang;
        } else if (SUPPORTED.indexOf(savedLang) !== -1) {
            activeLang = savedLang;
        } else if (SUPPORTED.indexOf(browserLang) !== -1) {
            activeLang = browserLang;
        }

        html.setAttribute('data-bl-lang', activeLang);
        html.setAttribute('lang', activeLang);
        try { localStorage.setItem('bl_lang', activeLang); } catch (e) {}

        // 3. Reader Typography & Layout Preferences (Font Size, Sans/Serif, Standard/Zen)
        try {
            var rSize = localStorage.getItem('bl_reading_size') || 'md';
            var rFont = localStorage.getItem('bl_reading_font') || 'sans';
            var rLayout = localStorage.getItem('bl_reading_layout') || 'standard';
            html.setAttribute('data-reading-size', rSize);
            html.setAttribute('data-reading-font', rFont);
            html.setAttribute('data-reading-layout', rLayout);
        } catch (e) {}
    })();
    </script>

    {{!-- Google Fonts: Onest (200 Thin to 800 ExtraBold Display), Inter (Body), Newsreader (Editorial Longform Serif), Roboto Mono (Telemetry) --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&family=Onest:wght@200;400;500;600;700;800&family=Roboto+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    {{!-- Base Ghost Koenig Card Styles + BusinessLeague Editorial Design System --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen-fixed.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "built/businessleague-editorial.css"}}" />

    {{!-- Organization & WebSite Structured Data for SEO / AEO / GEO / LLMs --}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Organization",
                "@id": "https://businessleague.com/#organization",
                "name": "BusinessLeague by 2Performant",
                "url": "https://businessleague.com",
                "logo": {
                    "@type": "ImageObject",
                    "url": "{{@site.url}}/assets/images/bl-logo.png"
                },
                "sameAs": [
                    "https://start.businessleague.com",
                    "https://newsroom.businessleague.com",
                    "https://www.linkedin.com/company/2performant/",
                    "https://www.facebook.com/2Performant",
                    "https://www.youtube.com/@2Performant",
                    "https://2performant.com"
                ]
            },
            {
                "@type": "WebSite",
                "@id": "{{@site.url}}/#website",
                "url": "{{@site.url}}",
                "name": "{{@site.title}}",
                "description": "{{@site.description}}",
                "publisher": {
                    "@id": "https://businessleague.com/#organization"
                },
                "inLanguage": ["ro", "en", "bg", "es"]
            }
        ]
    }
    </script>

    {{ghost_head}}
</head>
<body class="{{body_class}}">
<div class="bl-reading-progress" id="bl-reading-progress" aria-hidden="true"></div>

<div class="bl-viewport">
    {{!-- Sticky Two-Row Editorial Masthead Header --}}
    <header class="bl-header" role="banner">
        {{!-- ROW 1: Brand Identity + Live Autocomplete Search + Market Edition Switcher + Theme + CTA --}}
        <div class="bl-header-top">
            <div class="bl-header-top-inner">
                <a class="bl-brand" href="{{@site.url}}" aria-label="{{@site.title}} Home">
                    <img class="bl-brand-logo"
                         src="{{asset "images/bl-logo.png"}}"
                         alt="BusinessLeague"
                         width="148"
                         height="36"
                         fetchpriority="high" />
                    <span class="bl-brand-badge">Editorial</span>
                    <span class="bl-brand-tagline" data-i18n="header_tagline">Performance Marketing Journal</span>
                </a>

                <div class="bl-header-actions">
                    <div class="bl-search-wrap" id="bl-search-wrap" role="search">
                        <div class="bl-search-field">
                            <svg class="bl-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            <input type="search"
                                   id="bl-search-input"
                                   class="bl-search-input"
                                   placeholder="Caută articole, studii, branduri..."
                                   data-i18n-placeholder="search_placeholder"
                                   autocomplete="off"
                                   spellcheck="false"
                                   aria-label="Search articles"
                                   aria-expanded="false"
                                   aria-controls="bl-search-dropdown" />
                            <button type="button" class="bl-search-clear" id="bl-search-clear" aria-label="Clear search" hidden>&times;</button>
                            <kbd class="bl-search-kbd" id="bl-search-kbd">/</kbd>
                        </div>
                        <div class="bl-search-dropdown" id="bl-search-dropdown" role="listbox" aria-label="Autocomplete search results" hidden></div>
                    </div>

                    <div class="bl-lang-switcher" role="group" aria-label="Select Editorial Language">
                        <button type="button" class="bl-lang-btn" data-set-lang="ro" title="Română">
                            <span class="bl-lang-flag" aria-hidden="true">🇷🇴</span>
                            <span>RO</span>
                        </button>
                        <button type="button" class="bl-lang-btn" data-set-lang="en" title="English">
                            <span class="bl-lang-flag" aria-hidden="true">🇬🇧</span>
                            <span>EN</span>
                        </button>
                        <button type="button" class="bl-lang-btn" data-set-lang="bg" title="Български">
                            <span class="bl-lang-flag" aria-hidden="true">🇧🇬</span>
                            <span>BG</span>
                        </button>
                        <button type="button" class="bl-lang-btn" data-set-lang="es" title="Español">
                            <span class="bl-lang-flag" aria-hidden="true">🇪🇸</span>
                            <span>ES</span>
                        </button>
                    </div>

                    <button class="bl-theme-btn" id="bl-theme-toggle" type="button" aria-label="Toggle Dark / Light Mode" title="Toggle Dark / Light Mode">
                        <svg class="bl-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <svg class="bl-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                    </button>

                    <a class="bl-cta-btn" href="https://businessleague.com" target="_blank" rel="noopener">
                        <span data-i18n="cta_join">Intră în Ligă</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>

        {{!-- ROW 2: Full-Width Editorial Rubric Bar + Ecosystem Quicklinks --}}
        <div class="bl-header-bottom">
            <div class="bl-header-bottom-inner">
                <nav class="bl-nav" aria-label="Editorial Categories">
                    <a class="bl-nav-link is-active" href="{{@site.url}}/" data-pillar-link="all" data-i18n="pillar_all">Toate Secțiunile</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-data" data-pillar-link="data" data-i18n="pillar_data">Date &amp; Radiografii de Piață</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-interviews" data-pillar-link="interviews" data-i18n="pillar_interviews">Interviuri &amp; Studii de Caz</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-playbooks" data-pillar-link="playbooks" data-i18n="pillar_playbooks">Playbooks &amp; Strategie</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-competition" data-pillar-link="competition" data-i18n="pillar_competition">Competiție &amp; Evenimente</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-product" data-pillar-link="product" data-i18n="pillar_product">Produs &amp; Tech</a>
                    <a class="bl-nav-link" href="{{@site.url}}/#pillar-corporate" data-pillar-link="corporate" data-i18n="pillar_corporate">2Performant &amp; BVB</a>
                </nav>

                <div class="bl-header-quicklinks">
                    <a class="bl-nav-quicklink" href="https://start.businessleague.com" target="_blank" rel="noopener">
                        <span class="bl-live-dot" aria-hidden="true"></span>
                        <span>Community Hub</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                    <a class="bl-nav-quicklink" href="https://newsroom.businessleague.com" target="_blank" rel="noopener">
                        <span>Substack</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    {{!-- Main Template Content --}}
    <div class="site-content">
        {{{body}}}
    </div>

    {{!-- Common Shared Ecosystem Footer (BusinessLeague + 2Performant) --}}
    {{> "common-footer"}}
</div>

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

<script src="{{asset "built/casper.js"}}" defer></script>
<script src="{{asset "js/businessleague-editorial.js"}}" defer></script>

{{ghost_foot}}
</body>
</html>
