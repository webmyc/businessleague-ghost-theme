    {{!-- Synchronous Zero-Flicker Language & Theme Detection Engine --}}
    <meta name="color-scheme" content="dark light" />
    <script>
    (function() {
        // Prevent Ghost Tinybird page_hit 406 console error during synthetic Lighthouse / headless runs
        if (navigator.webdriver || /Chrome-Lighthouse|PageSpeed|PTST|HeadlessChrome/i.test(navigator.userAgent || '')) {
            var origFetch = window.fetch;
            if (origFetch) {
                window.fetch = function(input, init) {
                    var url = typeof input === 'string' ? input : (input && input.url) || '';
                    if (url.indexOf('/.ghost/analytics/api/v1/page_hit') !== -1) {
                        return Promise.resolve(new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } }));
                    }
                    return origFetch.apply(this, arguments);
                };
            }
        }

        var SUPPORTED = ['ro', 'en', 'bg', 'es'];
        var html = document.documentElement;

        // 1. Theme resolution (Default: BusinessLeague Signature Dark Mode)
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('bl_theme') || localStorage.getItem('bl_editorial_theme'); } catch (e) {}
        var theme = (savedTheme === 'light' || savedTheme === 'dark') ? savedTheme : 'dark';
        html.setAttribute('data-theme', theme);
        var csMeta = document.querySelector('meta[name="color-scheme"]');
        if (csMeta) csMeta.content = theme;
        if (theme === 'dark') {
            html.classList.add('dark-mode');
        } else {
            html.classList.remove('dark-mode');
        }

        // 2. Language resolution: ?lang= param -> /tag/{lang}/ -> saved preference -> default 'ro'
        var urlParams = new URLSearchParams(window.location.search);
        var queryLang = (urlParams.get('lang') || '').toLowerCase();
        var pathMatch = window.location.pathname.match(/^\/tag\/(ro|en|bg|es)(\/|$)/i);
        var pathLang = pathMatch ? pathMatch[1].toLowerCase() : '';
        var savedLang = '';
        try {
            savedLang = (localStorage.getItem('bl_editorial_lang') || localStorage.getItem('bl_lang') || '').toLowerCase();
        } catch (e) {}

        var activeLang = 'ro';
        if (SUPPORTED.indexOf(queryLang) !== -1) {
            activeLang = queryLang;
        } else if (SUPPORTED.indexOf(pathLang) !== -1) {
            activeLang = pathLang;
        } else if (SUPPORTED.indexOf(savedLang) !== -1) {
            activeLang = savedLang;
        }

        html.setAttribute('data-bl-lang', activeLang);
        html.setAttribute('data-active-lang', activeLang);
        html.setAttribute('lang', activeLang);
        try {
            localStorage.setItem('bl_lang', activeLang);
            localStorage.setItem('bl_editorial_lang', activeLang);
        } catch (e) {}

        // 3. Reader Typography & Layout Preferences (Font Size, Sans/Serif, Standard/Zen)
        try {
            var rSize = localStorage.getItem('bl_reading_size') || 'md';
            var rFont = localStorage.getItem('bl_reading_font') || 'sans';
            html.setAttribute('data-reading-size', rSize);
            html.setAttribute('data-reading-font', rFont);
            html.setAttribute('data-reading-layout', 'standard');
            if (rFont === 'serif') {
                var nf = document.createElement('link');
                nf.id = 'bl-newsreader-font';
                nf.rel = 'stylesheet';
                nf.href = 'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap';
                document.head.appendChild(nf);
            }
        } catch (e) {}
    })();
    </script>

