    </div>

    {{!-- Common Shared Ecosystem Footer (BusinessLeague + 2Performant) --}}
    {{> "common-footer"}}
</div>

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Server-Rendered Multilingual Search Index inside inert <template> (Zero DOM bloat & Zero API Key Required) --}}
{{#get "posts" limit="150" include="tags" as |search_posts|}}
    {{#if search_posts}}
        <template id="bl-ghost-search-data">
            {{#foreach search_posts}}
                <span data-s-slug="{{slug}}"
                      data-s-url="{{url}}"
                      data-s-title="{{title}}"
                      data-s-date="{{date format="DD MMM YYYY"}}"
                      data-s-tags="{{#foreach tags visibility="all"}}{{slug}},{{/foreach}}"></span>
            {{/foreach}}
        </template>
    {{/if}}
{{/get}}

<script src="{{asset "built/businessleague-editorial.js"}}" defer></script>

{{ghost_foot}}
</body>
</html>
