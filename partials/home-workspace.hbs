{{!-- BusinessLeague Per-Language Journalistic Magazine Workspace Partial --}}
<div class="bl-lang-workspace{{#if is_default_lang}} is-active{{/if}}" data-lang-panel="{{lang_code}}" data-lang-filter="{{lang_filter}}"{{#unless is_default_lang}} hidden{{/unless}}>
    {{#unless is_default_lang}}<template data-ws-template="{{lang_code}}">{{/unless}}
    {{#get "posts" filter=lang_filter include="tags,authors" order="featured desc, published_at desc" limit="22" as |lang_posts|}}
        {{#if lang_posts}}
            {{!-- 1. FRONT PAGE 7:5 CINEMATIC MAVERICK HERO SPLIT --}}
            <section class="bl-hero-split" data-hero-section>
                <div class="bl-hero-left-col">
                    {{#foreach lang_posts from="1" to="1"}}
                    <div class="bl-cover-stage-wrap">
                        {{!-- Spinning Maverick Seal Stamp (from start.businessleague.com aesthetic) --}}
                        <svg class="bl-maverick-stamp" viewBox="0 0 124 124" aria-hidden="true">
                            <defs>
                                <path id="bl-stamp-arc-{{../../lang_code}}" d="M62 62 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"/>
                            </defs>
                            <circle class="s-disc" cx="62" cy="62" r="60"/>
                            <text>
                                <textPath href="#bl-stamp-arc-{{../../lang_code}}" textLength="280" lengthAdjust="spacing">THE OUTLIER · COVER STORY · REAL DATA ·</textPath>
                            </text>
                            <path class="s-tri" d="M65 44L50 64h11l-2 16 15-20H63z"/>
                        </svg>

                        <article class="bl-lead-card bl-cinematic-cover"
                                 data-post-id="{{id}}"
                                 data-post-slug="{{slug}}"
                                 data-published="{{date format="YYYY-MM-DD"}}"
                                 data-authors="{{#foreach authors}}{{slug}},{{/foreach}}"
                                 data-tags="{{#foreach tags visibility="all"}}{{slug}},{{/foreach}}">
                            <div class="bl-cover-topbar">
                                <span class="bl-cover-issue-tag">
                                    <span class="bl-live-dot" aria-hidden="true"></span>
                                    <span data-i18n="cover_story_tag">COVER STORY // #01</span>
                                </span>
                                <div class="bl-meta-row" style="margin:0;">
                                    <span class="bl-pillar-badge" data-pillar-badge>
                                        {{#primary_tag}}{{name}}{{else}}Lead Story{{/primary_tag}}
                                    </span>
                                    <time class="bl-meta-time" datetime="{{date format="YYYY-MM-DD"}}">
                                        {{date format="DD MMM YYYY"}}
                                        {{#if reading_time}}&bull; {{reading_time}}{{/if}}
                                    </time>
                                </div>
                            </div>

                            <a class="bl-lead-media" href="{{url}}" aria-label="{{title}}">
                                {{#if feature_image}}
                                <img src="{{img_url feature_image size="m" format="webp"}}"
                                     srcset="{{img_url feature_image size="s" format="webp"}} 300w,
                                             {{img_url feature_image size="m" format="webp"}} 600w,
                                             {{img_url feature_image size="l" format="webp"}} 1000w,
                                             {{img_url feature_image size="xl" format="webp"}} 2000w"
                                     sizes="(max-width: 680px) 320px, (max-width: 1120px) 52vw, 600px"
                                     width="600"
                                     height="338"
                                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                     {{#if ../../is_default_lang}}fetchpriority="high"{{else}}loading="lazy" decoding="async"{{/if}} />
                                {{else}}
                                    {{> "category-cover"}}
                                {{/if}}
                            </a>

                            <div class="bl-lead-body">
                                <h2 class="bl-lead-title">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>
                                {{#if excerpt}}
                                    <p class="bl-lead-excerpt">{{excerpt words="42"}}</p>
                                {{/if}}
                                <footer class="bl-card-footer">
                                    {{#if authors}}
                                    <div class="bl-author-chip">
                                        <span class="bl-author-avatars">
                                            {{#foreach authors}}
                                                {{#if profile_image}}
                                                    <a class="bl-author-avatar-link" href="{{url}}" title="{{name}}" aria-label="{{name}}">
                                                        <img class="bl-author-avatar" src="{{img_url profile_image size="xs" format="webp"}}" alt="" width="28" height="28" loading="lazy" decoding="async" />
                                                    </a>
                                                {{/if}}
                                            {{/foreach}}
                                        </span>
                                        <span class="bl-author-names">
                                            {{#foreach authors}}<a class="bl-author-name-link" href="{{url}}">{{name}}</a>{{#unless @last}}<span class="bl-author-sep">, </span>{{/unless}}{{/foreach}}
                                        </span>
                                    </div>
                                    {{/if}}
                                    <a class="bl-cover-cta-btn" href="{{url}}" aria-label="{{title}}">
                                        <span data-i18n="read_lead">Citește Cover Story-ul</span>
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>
                                </footer>
                            </div>
                        </article>
                    </div>
                    {{/foreach}}

                    {{!-- Secondary Dual Sub-Lead Stories Under Main Cover --}}
                    <div class="bl-hero-subgrid">
                        {{#foreach lang_posts from="2" to="3"}}
                            {{> "post-card"}}
                        {{/foreach}}
                    </div>

                    {{!-- Tilted Maverick Ecosystem Dossier Card (Balances Left Column Under Sub-Lead Cards) --}}
                    <div class="bl-outlier-dossier-wrap">
                        <aside class="bl-outlier-dossier" aria-label="BusinessLeague Community Hub">
                            <header class="bl-dossier-header">
                                <span class="bl-dossier-live">
                                    <span class="bl-live-dot" aria-hidden="true"></span>
                                    <span>COMMUNITY HUB</span>
                                </span>
                                <span class="bl-dossier-code">start.businessleague.com</span>
                            </header>
                            <h4 class="bl-dossier-title" data-i18n-html="eco_title_html">
                                Campionatul care e, de fapt, <span class="bl-thin">o comunitate.</span>
                            </h4>
                            <dl class="bl-dossier-dl">
                                <dt>PULSE</dt>
                                <dd><a href="https://start.businessleague.com/pulse" target="_blank" rel="noopener" data-i18n="dossier_pulse">1 email/săptămână cu tot ce mișcă în Ligă ↗</a></dd>
                                <dt>MEETUPS</dt>
                                <dd><a href="https://luma.com/2performant" target="_blank" rel="noopener" data-i18n="dossier_events">Dublin, București &amp; sesiuni live pe Luma ↗</a></dd>
                            </dl>
                            <div class="bl-dossier-actions">
                                <a class="bl-cta-btn" href="https://start.businessleague.com" target="_blank" rel="noopener">
                                    <span data-i18n="dossier_hub_btn">Deschide Hub-ul</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                                <a class="bl-filter-pill" href="https://businessleague.com/sign-up" target="_blank" rel="noopener" style="text-decoration:none;">
                                    <span data-i18n="cta_join">Intră în Ligă</span>
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </aside>
                    </div>
                </div>

                <div class="bl-hero-side">
                    <div class="bl-side-header">
                        <h3 class="bl-side-heading" data-i18n="hero_side_title">În Prim-Plan &bull; Selecția Redacției</h3>
                        <span class="bl-side-live-tag">THE MAVERICK WIRE</span>
                    </div>

                    {{#foreach lang_posts from="4" to="7"}}
                    <article class="bl-side-card"
                             data-post-id="{{id}}"
                             data-post-slug="{{slug}}"
                             data-published="{{date format="YYYY-MM-DD"}}"
                             data-authors="{{#foreach authors}}{{slug}},{{/foreach}}"
                             data-tags="{{#foreach tags visibility="all"}}{{slug}},{{/foreach}}">
                        <a class="bl-side-media" href="{{url}}" aria-label="{{title}}">
                            {{#if feature_image}}
                            <img src="{{img_url feature_image size="s" format="webp"}}"
                                 srcset="{{img_url feature_image size="xs" format="webp"}} 100w,
                                         {{img_url feature_image size="s" format="webp"}} 300w"
                                 sizes="116px"
                                 width="300"
                                 height="169"
                                 decoding="async"
                                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                 loading="lazy" />
                            {{else}}
                                {{> "category-cover"}}
                            {{/if}}
                        </a>
                        <div class="bl-side-content">
                            <div class="bl-meta-row">
                                <span class="bl-side-index">0{{@number}}</span>
                                <span class="bl-pillar-badge" data-pillar-badge>
                                    {{#primary_tag}}{{name}}{{else}}Editorial{{/primary_tag}}
                                </span>
                                <time class="bl-meta-time" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                            </div>
                            <h4 class="bl-side-title">
                                <a href="{{url}}">{{title}}</a>
                            </h4>
                            {{#if authors}}
                            <div class="bl-author-chip" hidden>
                                <span class="bl-author-avatars">
                                    {{#foreach authors}}
                                        {{#if profile_image}}
                                            <a class="bl-author-avatar-link" href="{{url}}" title="{{name}}" aria-label="{{name}}">
                                                <img class="bl-author-avatar" src="{{img_url profile_image size="xs" format="webp"}}" alt="" width="28" height="28" loading="lazy" decoding="async" />
                                            </a>
                                        {{/if}}
                                    {{/foreach}}
                                </span>
                                <span class="bl-author-names">
                                    {{#foreach authors}}<a class="bl-author-name-link" href="{{url}}">{{name}}</a>{{#unless @last}}<span class="bl-author-sep">, </span>{{/unless}}{{/foreach}}
                                </span>
                            </div>
                            {{/if}}
                        </div>
                    </article>
                    {{/foreach}}

                    {{!-- Live Luma Next Community Events Card --}}
                    {{> "community-events-card"}}

                    {{!-- Subscription Box to start.businessleague.com/pulse --}}
                    <aside class="bl-pulse-subscribe-card" aria-label="Subscribe to BusinessLeague Pulse">
                        <svg class="bl-pulse-sub-watermark" viewBox="0 0 150 64" fill="none" aria-hidden="true">
                            <path d="M0 32h34l9-9 8 9h12l10-28 14 54 12-40 8 14h43" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <div class="bl-pulse-sub-kicker-row">
                            <div class="bl-pulse-sub-kicker">
                                <span class="bl-pulse-sub-dot" aria-hidden="true"></span>
                                <span data-i18n="pulse_sub_kicker">THE LEAGUE PULSE &bull; WEEKLY BRIEFING</span>
                            </div>
                            <a href="https://start.businessleague.com/pulse" target="_blank" rel="noopener" class="bl-pulse-sub-freq" data-i18n="pulse_sub_archive_badge">ARHIVA /PULSE ↗</a>
                        </div>
                        <h4 class="bl-pulse-sub-title" data-i18n="pulse_sub_title">Abonează-te la The League Pulse</h4>
                        <p class="bl-pulse-sub-desc" data-i18n="pulse_sub_desc">
                            1 email pe săptămână cu clasamentele live, studii de caz pe cifre reale și mișcările din campionat.
                        </p>
                        <form class="bl-pulse-sub-form" action="https://start.businessleague.com/pulse" method="get" target="_blank">
                            <input type="email"
                                   name="email"
                                   class="bl-pulse-sub-input"
                                   aria-label="Email address"
                                   placeholder="Adresa ta de email..."
                                   data-i18n-placeholder="pulse_sub_placeholder"
                                   required />
                            <button type="submit" class="bl-pulse-sub-btn">
                                <span data-i18n="pulse_sub_btn">Abonează-te &rarr;</span>
                            </button>
                        </form>
                        <div class="bl-pulse-sub-foot">
                            <a href="https://start.businessleague.com/#pulse" target="_blank" rel="noopener" class="bl-pulse-sub-direct">
                                <span data-i18n="pulse_sub_direct_link">Abonare directă (#pulse) ↗</span>
                            </a>
                            <a href="https://start.businessleague.com/pulse" target="_blank" rel="noopener" class="bl-pulse-sub-archive">
                                <span data-i18n="pulse_sub_archive_link">Citește Arhiva /pulse ↗</span>
                            </a>
                        </div>
                    </aside>
                </div>
            </section>

            {{!-- Signature Green ECG Pulse Line Divider (Connecting Front Page Hero to Magazine Sections) --}}
            <div class="bl-pulse-line bl-section-pulse" aria-hidden="true">
                <i></i>
                <svg width="150" height="52" viewBox="0 0 150 64">
                    <path d="M0 32h34l9-9 8 9h12l10-28 14 54 12-40 8 14h43"/>
                </svg>
                <i></i>
            </div>

            {{!-- 1B. CATEGORY REPORTS & WHITEPAPERS (PDF) SHOWCASE --}}
            <section class="bl-section bl-reports-section" id="{{#if ../is_default_lang}}pillar-reports{{else}}pillar-reports-{{../lang_code}}{{/if}}" data-reports-section="{{../lang_code}}" data-report-cover-sample="{{asset "images/reports/pharma-ro.webp"}}">
                <div class="bl-reports-header">
                    <div class="bl-reports-header-copy">
                        <span class="bl-section-eyebrow" data-i18n="sec_reports_eyebrow">RAPOARTE DE CATEGORIE &amp; WHITEPAPERS // STUDII PDF COMPLETE</span>
                        <h2 class="bl-section-title" data-i18n="sec_reports_title">Radiografiile E-Commerce BusinessLeague (PDF)</h2>
                        <p class="bl-reports-subtitle" data-i18n="sec_reports_subtitle">Studii de piață bazate pe milioane de comenzi reale din ecosistemul BusinessLeague. Apasă pe copertă sau pe buton pentru a deschide raportul PDF complet în tab nou.</p>
                    </div>
                    <button type="button" class="bl-filter-pill" data-filter-pillar="data">
                        <span data-i18n="report_all_data">Toate analizele de piață &rarr;</span>
                    </button>
                </div>
                <div class="bl-reports-grid">
                    <article class="bl-report-card" data-report-id="pharma">
                        <a class="bl-report-cover-link" href="https://blog.businessleague.com/content/files/2026/10/BusinessLeague_Pharma_RO_v6.pdf" target="_blank" rel="noopener" aria-label="Pharma &amp; Health: 1,31M comenzi unice în 33 de luni — Deschide PDF-ul">
                            <div class="bl-report-cover-frame">
                                <div class="bl-report-cover-badges">
                                    <span class="bl-report-pdf-pill"><i></i>PDF &bull; RO</span>
                                    <span class="bl-report-date-pill">OCT 2026</span>
                                </div>
                                <img class="bl-report-cover-img" src="{{asset "images/reports/pharma-ro.webp"}}" alt="Pharma &amp; Health: 1,31M comenzi unice în 33 de luni (PDF RO)" width="680" height="962" loading="lazy" decoding="async" />
                                <span class="bl-report-cover-hover" aria-hidden="true">
                                    <span class="bl-report-cover-hover-btn">
                                        <span data-i18n="report_open_pdf">Deschide PDF-ul</span>
                                        <span>&#8599;</span>
                                    </span>
                                </span>
                            </div>
                        </a>
                        <div class="bl-report-body">
                            <span class="bl-report-kicker">RAPORT CATEGORIE // PHARMA</span>
                            <h3 class="bl-report-title"><a href="https://blog.businessleague.com/content/files/2026/10/BusinessLeague_Pharma_RO_v6.pdf" target="_blank" rel="noopener">Pharma &amp; Health: 1,31M comenzi unice în 33 de luni</a></h3>
                            <div class="bl-report-metrics">
                                <span class="bl-report-metric-chip">1,31M comenzi</span>
                                <span class="bl-report-metric-chip">€38,15M vânzări</span>
                                <span class="bl-report-metric-chip">29 magazine</span>
                            </div>
                            <p class="bl-report-desc">Radiografia completă a categoriei Pharma în BusinessLeague: €38,15M vânzări fără TVA, 29 de farmacii și magazine analizate, sezonalitate și comportament de achiziție.</p>
                            <div class="bl-report-actions">
                                <a class="bl-report-pdf-btn" href="https://blog.businessleague.com/content/files/2026/10/BusinessLeague_Pharma_RO_v6.pdf" target="_blank" rel="noopener">
                                    <svg class="bl-report-pdf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
                                    <span data-i18n="report_open_pdf">Deschide PDF-ul</span>
                                    <span class="bl-report-pdf-arrow" aria-hidden="true">&#8599;</span>
                                </a>
                                <div class="bl-report-subactions">
                                    <a class="bl-report-article-link" href="/pharma-peste-1-3-milioane-de-comenzi-unice-in-33-de-luni/"><span data-i18n="report_read_article">Citește sinteza &rarr;</span></a>
                                    <a class="bl-report-alt-pdf" href="https://blog.businessleague.com/content/files/2026/10/BusinessLeague_Pharma_EN_v6.pdf" target="_blank" rel="noopener">EN PDF &#8599;</a>
                                </div>
                            </div>
                        </div>
                    </article>
                    <article class="bl-report-card" data-report-id="electronics">
                        <a class="bl-report-cover-link" href="https://blog.businessleague.com/content/files/2026/09/BusinessLeague_Electronics_ITC_RO.pdf" target="_blank" rel="noopener" aria-label="Electronics &amp; IT&amp;C: 428.184 comenzi și €74,37M vânzări — Deschide PDF-ul">
                            <div class="bl-report-cover-frame">
                                <div class="bl-report-cover-badges">
                                    <span class="bl-report-pdf-pill"><i></i>PDF &bull; RO</span>
                                    <span class="bl-report-date-pill">SEP 2026</span>
                                </div>
                                <img class="bl-report-cover-img" src="{{asset "images/reports/electronics-ro.webp"}}" alt="Electronics &amp; IT&amp;C: 428.184 comenzi și €74,37M vânzări (PDF RO)" width="680" height="962" loading="lazy" decoding="async" />
                                <span class="bl-report-cover-hover" aria-hidden="true">
                                    <span class="bl-report-cover-hover-btn">
                                        <span data-i18n="report_open_pdf">Deschide PDF-ul</span>
                                        <span>&#8599;</span>
                                    </span>
                                </span>
                            </div>
                        </a>
                        <div class="bl-report-body">
                            <span class="bl-report-kicker">RAPORT CATEGORIE // IT&amp;C</span>
                            <h3 class="bl-report-title"><a href="https://blog.businessleague.com/content/files/2026/09/BusinessLeague_Electronics_ITC_RO.pdf" target="_blank" rel="noopener">Electronics &amp; IT&amp;C: 428.184 comenzi și €74,37M vânzări</a></h3>
                            <div class="bl-report-metrics">
                                <span class="bl-report-metric-chip">428.184 comenzi</span>
                                <span class="bl-report-metric-chip">€74,37M vânzări</span>
                                <span class="bl-report-metric-chip">148 magazine</span>
                            </div>
                            <p class="bl-report-desc">Analiza celor 148 de magazine din categoria Electronics &amp; IT&amp;C: coș mediu de €173,7, evoluția Black Friday și distribuția comenzilor pe subcategorii.</p>
                            <div class="bl-report-actions">
                                <a class="bl-report-pdf-btn" href="https://blog.businessleague.com/content/files/2026/09/BusinessLeague_Electronics_ITC_RO.pdf" target="_blank" rel="noopener">
                                    <svg class="bl-report-pdf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
                                    <span data-i18n="report_open_pdf">Deschide PDF-ul</span>
                                    <span class="bl-report-pdf-arrow" aria-hidden="true">&#8599;</span>
                                </a>
                                <div class="bl-report-subactions">
                                    <a class="bl-report-article-link" href="/electronics-it-c-428-184-comenzi-unice-in-26-de-luni/"><span data-i18n="report_read_article">Citește sinteza &rarr;</span></a>
                                    <a class="bl-report-alt-pdf" href="https://blog.businessleague.com/content/files/2026/09/BusinessLeague_Electronics_ITC_EN3.pdf" target="_blank" rel="noopener">EN PDF &#8599;</a>
                                </div>
                            </div>
                        </div>
                    </article>
                    <article class="bl-report-card" data-report-id="books">
                        <a class="bl-report-cover-link" href="https://blog.businessleague.com/content/files/2026/08/Cum-se-cumpara-carti-online-2026-1.pdf" target="_blank" rel="noopener" aria-label="Cum se cumpără cărți online: Piață de €29,8M și 1,23M comenzi — Deschide PDF-ul">
                            <div class="bl-report-cover-frame">
                                <div class="bl-report-cover-badges">
                                    <span class="bl-report-pdf-pill"><i></i>PDF &bull; RO</span>
                                    <span class="bl-report-date-pill">AUG 2026</span>
                                </div>
                                <img class="bl-report-cover-img" src="{{asset "images/reports/books-ro.webp"}}" alt="Cum se cumpără cărți online: Piață de €29,8M și 1,23M comenzi (PDF RO)" width="680" height="962" loading="lazy" decoding="async" />
                                <span class="bl-report-cover-hover" aria-hidden="true">
                                    <span class="bl-report-cover-hover-btn">
                                        <span data-i18n="report_open_pdf">Deschide PDF-ul</span>
                                        <span>&#8599;</span>
                                    </span>
                                </span>
                            </div>
                        </a>
                        <div class="bl-report-body">
                            <span class="bl-report-kicker">RAPORT CATEGORIE // BOOKS</span>
                            <h3 class="bl-report-title"><a href="https://blog.businessleague.com/content/files/2026/08/Cum-se-cumpara-carti-online-2026-1.pdf" target="_blank" rel="noopener">Cum se cumpără cărți online: Piață de €29,8M și 1,23M comenzi</a></h3>
                            <div class="bl-report-metrics">
                                <span class="bl-report-metric-chip">1,24M comenzi</span>
                                <span class="bl-report-metric-chip">€29,8M vânzări</span>
                                <span class="bl-report-metric-chip">43 librării</span>
                            </div>
                            <p class="bl-report-desc">41,1% dintre comenzile de cărți conțin un singur produs. Radiografia completă a 1.236.336 de comenzi generate pentru 43 de librării online.</p>
                            <div class="bl-report-actions">
