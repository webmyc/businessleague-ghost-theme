{{!-- BusinessLeague Editorial Post Card (Zero Image Cropping + Category Cover Template Fallback) --}}
<article class="bl-card post-card {{post_class}}"
         data-post-id="{{id}}"
         data-post-slug="{{slug}}"
         data-published="{{date format="YYYY-MM-DD"}}"
         data-tags="{{#foreach tags visibility="all"}}{{slug}},{{/foreach}}"
         data-pillar="auto">

    <a class="bl-card-media" href="{{url}}" aria-label="{{title}}">
        {{#if feature_image}}
        <img src="{{img_url feature_image size="l"}}"
             srcset="{{img_url feature_image size="s"}} 300w,
                     {{img_url feature_image size="m"}} 600w,
                     {{img_url feature_image size="l"}} 1000w,
                     {{img_url feature_image size="xl"}} 1600w"
             sizes="(max-width: 680px) 94vw, (max-width: 1120px) 46vw, 410px"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             loading="lazy"
             onerror="this.style.display='none';if(this.nextElementSibling){this.nextElementSibling.style.display='flex';}" />
        <div class="bl-generated-cover" data-cover-pillar="interviews" style="display:none;">
            <img class="bl-generated-cover-bg" src="{{asset "images/covers/cover-interviews.svg"}}" data-cover-template-img alt="{{title}}" loading="lazy" />
            <div class="bl-generated-cover-overlay">
                <span class="bl-generated-cover-kicker" data-cover-kicker>{{#primary_tag}}{{name}}{{else}}BUSINESSLEAGUE{{/primary_tag}}</span>
                <span class="bl-generated-cover-headline">{{title}}</span>
                <span class="bl-generated-cover-brand">BUSINESSLEAGUE &bull; 2PERFORMANT</span>
            </div>
        </div>
        {{else}}
            {{> "category-cover"}}
        {{/if}}
    </a>

    <div class="bl-card-body">
        <div class="bl-meta-row">
            <span class="bl-pillar-badge" data-pillar-badge>
                {{#primary_tag}}{{name}}{{else}}BusinessLeague{{/primary_tag}}
            </span>
            <time class="bl-meta-time" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMM YYYY"}}
                {{#if reading_time}}&bull; {{reading_time}}{{/if}}
            </time>
        </div>

        <h3 class="bl-card-title">
            <a href="{{url}}">{{title}}</a>
        </h3>

        {{#if excerpt}}
            <p class="bl-card-excerpt">{{excerpt words="26"}}</p>
        {{/if}}

        <footer class="bl-card-footer">
            {{#primary_author}}
            <a class="bl-author-chip" href="{{url}}">
                {{#if profile_image}}
                    <img class="bl-author-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy" />
                {{/if}}
                <span>{{name}}</span>
            </a>
            {{/primary_author}}

            <a class="bl-read-cta" href="{{url}}">
                <span data-i18n="read_article">Citește</span>
                <span aria-hidden="true">&rarr;</span>
            </a>
        </footer>
    </div>
</article>
